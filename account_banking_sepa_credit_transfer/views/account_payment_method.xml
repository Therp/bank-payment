<odoo>
  <record id="view_account_payment_method_form_inherit_sepa_hybrid" model="ir.ui.view">
    <field name="name">account.payment.method.form.sepa.hybrid</field>
    <field name="model">account.payment.method</field>
    <field name="inherit_id" ref="account_payment_mode.account_payment_method_form" />
    <field name="arch" type="xml">
        <field name="pain_version" position="after">
            <field
                    name="enforce_sepa_hybrid_mode"
                    attrs="{'invisible': [('pain_version', '!=', 'pain.001.001.09')]}"
                />
            <field
                    name="sepa_hybrid_include_address"
                    attrs="{'invisible': ['|', ('pain_version', '!=', 'pain.001.001.09'), ('enforce_sepa_hybrid_mode', '=', False)]}"
                />
        </field>
    </field>
  </record>
</odoo>
